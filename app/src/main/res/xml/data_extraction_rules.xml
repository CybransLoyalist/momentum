<?xml version="1.0" encoding="utf-8"?>
<!--
  Warstwa A kopii zapasowej ze specyfikacji: Android sam wysyla dane aplikacji
  na Dysk Google raz na dobe i odtwarza je na nowym telefonie.
  Wykluczamy tokeny OAuth - te maja byc pobrane na nowo po zalogowaniu.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="auth.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
